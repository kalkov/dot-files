alias ku='kubectl'

kup() {
  kubectl get pods
}

kul() {
  kubectl logs -f $1
}

kue() {
  kubectl exec -it $1 sh
}

san-ku-aws-stage() {
    kubectl config use-context k8s-stage.internal.santiment.net
}

san-ku-hetzner-stage() {
    kubectl config use-context hetzner-stage
}

san-ku-aws-prod() {
    kubectl config use-context aws-prod
}

san-ku-hetzner-prod() {
    kubectl config use-context hetzner-prod
}

san-ku-blockchain() {
    kubectl config use-context blockchain
}

san-ku-minikube() {
    unset KUBECONFIG
    unset KUBE_CONFIG
    export KUBECONFIG=$KUBECONFIG:/home/merops/.kube/minikube
    export KUBE_CONFIG=/home/merops/.kube/minikube
}

san-ku-config() {
  echo $KUBE_CONFIG
}


san-wg-stage-up() {
  sudo wg-quick up wg-client-stage
}

san-wg-stage-down(){
  sudo wg-quick down wg-client-stage
}

san-wg-prod-up() {
  sudo wg-quick up wg-client-prod
}

san-wg-prod-down() {
  sudo wg-quick down wg-client-prod
}

san-wg-down() {
  sudo wg-quick down wg-client-stage
  sudo wg-quick down wg-client-prod
}

san-aws-prod() {
  export AWS_PROFILE=santiment
}

san-aws-personal() {
  export AWS_PROFILE=personal
}

ku-terrarino() {
  unset KUBECONFIG
  unset KUBE_CONFIG
  export KUBECONFIG=$KUBECONFIG:/home/merops/.kube/terrarino
  export KUBE_CONFIG=/home/merops/.kube/terrarino
  export AWS_PROFILE=personal
}

san-vault-setup() {
  local vault_dir="$HOME/.config/vault"
  mkdir -p "$vault_dir"
  chmod 700 "$vault_dir"
  for cluster in system aws-prod aws-stage hetzner-stage hetzner-prod; do
    local env_file="$vault_dir/${cluster}.env"
    if [[ ! -f "$env_file" ]]; then
      printf 'export VAULT_USER=FILL_IN\nexport VAULT_PASS=FILL_IN\n' > "$env_file"
      chmod 600 "$env_file"
      echo "Created: $env_file"
    else
      echo "Exists:  $env_file"
    fi
  done
  echo ""
  echo "Fill in credentials, then test with: vault-ctx <cluster> status"
}

